@@ -611,4 +612,10 @@
 ScriptPromise<IDLNullable<GPUAdapter>> GPU::requestAdapter(
     ScriptState* script_state,
     const GPURequestAdapterOptions* options) {
+  if (fp_config::ModeIs("webgpu.mode", "disabled")) {
+    auto* resolver = MakeGarbageCollected<ScriptPromiseResolver<IDLNullable<GPUAdapter>>>(script_state);
